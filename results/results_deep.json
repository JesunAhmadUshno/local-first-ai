  "verdict": {
    "axis_winners": [
      {
        "axis": "cost",
        "evidence": "local marginal API cost is zero by construction; cloud costs are modelled from published pricing",
        "winner": "local"
      },
      {
        "axis": "speed",
        "evidence": "local latency is measured on this corpus; the cloud figure is a labelled assumed range, so the win is order of magnitude only and corpus bound",
        "winner": "local"
      },
      {
        "axis": "quality_on_eval_set",
        "evidence": "measured on the Build eval set only; cloud quality is not measured in this study",
        "winner": "local"
      },
      {
        "axis": "quality_capability",
        "evidence": "capability comparison, not a measurement: generation, paraphrase, synthesis, and general knowledge against extraction only",
        "winner": "cloud"
      },
      {
        "axis": "privacy",
        "evidence": "source audit with zero network pattern matches and no data transfer by construction, against a prompt transfer to the provider by construction",
        "winner": "local"
      }
    ],
    "decision_rules": [
      {
        "condition": "the data must not leave the device, or the work must run offline",
        "reason": "the cloud prompt carries the question and the retrieved private chunks to the provider; the local pipeline sends nothing anywhere",
        "winner": "local"
      },
      {
        "condition": "the question needs paraphrase, synonyms, facts combined across documents, or general knowledge the documents do not hold",
        "reason": "the local core is extractive and exact token matching only; it cannot do any of these, and refuses or misses instead",
        "winner": "cloud"
      },
      {
        "condition": "the question is a lookup whose answer is a sentence inside the local documents, at any volume",
        "reason": "measured local quality on the eval set is perfect and the marginal API cost is zero, while every cloud query carries a modelled fee and a data transfer",
        "winner": "local"
      },
      {
        "condition": "the corpus is large, messy, or in formats beyond plain text",
        "reason": "the local ingest reads plain text files with a Title first line only; hosted models accept far more, at the modelled price and with the privacy transfer named above",
        "winner": "cloud"
      },
      {
        "condition": "a fluent written answer matters more than a verbatim cited sentence",
        "reason": "the local core returns copied sentences and cannot write; a generative model writes, and can also write without evidence, which the local refusal rule exists to prevent",
        "winner": "cloud"
      }
    ]
  }
}
